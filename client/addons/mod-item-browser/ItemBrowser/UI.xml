<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">

    <!--
      ItemBrowser — frame layout.

      Widget tree in XML, behaviour in UI.lua and Tree.lua, the 3.3.5 way. Everything here
      inherits from FrameXML templates confirmed present in THIS client's archives
      (UIPanelTemplates.xml, UIDropDownMenuTemplates.xml, OptionsPanelTemplates.xml), and
      every texture path was probed against the client's MPQ chain, so nothing depends on a
      library the pack does not ship or on an asset a later expansion added.

      THE SHAPE, top to bottom:

        name box · quality · usable · reset          one line of the things you type or tick
        Levels box                                   two ranges, each with sliders, boxes and
                                                     a row of one-click bands. The two are
                                                     labelled REQUIRED LEVEL and ITEM LEVEL in
                                                     full, because they are different numbers
                                                     and "between 10 and 15" means neither
                                                     until you say which.
        categories tree | results                    the auction house's own three-tier browse
                                                     list on the left: class, subclass, slot
        selection · recipient · quantity · Give      who gets what, spelled out

      WIDGET COUNTS. Nothing here scales with the 46,098-row database. The result rows and the
      tree rows are pools sized to the window (UI.lua ROW_HEIGHT / Tree.lua NODE_HEIGHT) and
      re-filled from a scroll offset; the level presets are a fixed handful built in Lua. A
      search that matches everything draws exactly as many widgets as one that matches nothing.
    -->

    <Script file="UI.lua"/>
    <Script file="Tree.lua"/>
    <Script file="Launcher.lua"/>

    <!--
      One result row.

      The icon is TWO stacked textures on purpose. Five of the 4,851 distinct icon names in
      ItemDisplayInfo.dbc have no .blp anywhere in the client's archives (all of them on
      internal junk rows like "NPC Equip 6128"), and a texture with an unresolvable path
      simply draws nothing. Parking a question mark in the BACKGROUND layer means those rows
      show a question mark instead of a hole, with no per-item special-casing anywhere.

      The name column is anchored on BOTH sides, so it grows when the window is resized while
      the four right-hand columns stay put.
    -->
    <Button name="ItemBrowserRowTemplate" virtual="true">
        <Size>
            <AbsDimension x="500" y="28"/>
        </Size>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentIconFallback" file="Interface\Icons\INV_Misc_QuestionMark">
                    <Size>
                        <AbsDimension x="24" y="24"/>
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset>
                                <AbsDimension x="4" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                    <TexCoords left="0.07" right="0.93" top="0.07" bottom="0.93"/>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture name="$parentSelected" file="Interface\QuestFrame\UI-QuestTitleHighlight"
                         alphaMode="ADD" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture name="$parentIcon">
                    <Size>
                        <AbsDimension x="24" y="24"/>
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset>
                                <AbsDimension x="4" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                    <!--
                      Crops the dark border baked into every Interface\Icons\ .blp. The whole
                      UI does this (see any action button); without it a 24px icon spends
                      three of those pixels on a smudge.
                    -->
                    <TexCoords left="0.07" right="0.93" top="0.07" bottom="0.93"/>
                </Texture>
                <!--
                  wordwrap="false" maxLines="1" on every text column: a FontString with a
                  fixed width and no cap WRAPS, and "Sanctified Ymirjar Lord's Breastplate"
                  wrapping to a second line inside a 28px row would push the layout apart.
                -->
                <FontString name="$parentName" inherits="GameFontNormal" justifyH="LEFT"
                            wordwrap="false" maxLines="1">
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentIcon" relativePoint="RIGHT">
                            <Offset>
                                <AbsDimension x="8" y="0"/>
                            </Offset>
                        </Anchor>
                        <Anchor point="RIGHT">
                            <Offset>
                                <AbsDimension x="-268" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentSlot" inherits="GameFontDisableSmall"
                            justifyH="RIGHT" wordwrap="false" maxLines="1">
                    <Size>
                        <AbsDimension x="118" y="12"/>
                    </Size>
                    <Anchors>
                        <Anchor point="RIGHT">
                            <Offset>
                                <AbsDimension x="-146" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentReq" inherits="GameFontHighlightSmall" justifyH="RIGHT">
                    <Size>
                        <AbsDimension x="38" y="12"/>
                    </Size>
                    <Anchors>
                        <Anchor point="RIGHT">
                            <Offset>
                                <AbsDimension x="-102" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentLevel" inherits="GameFontHighlightSmall"
                            justifyH="RIGHT">
                    <Size>
                        <AbsDimension x="38" y="12"/>
                    </Size>
                    <Anchors>
                        <Anchor point="RIGHT">
                            <Offset>
                                <AbsDimension x="-58" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentId" inherits="GameFontDisableSmall" justifyH="RIGHT">
                    <Size>
                        <AbsDimension x="46" y="12"/>
                    </Size>
                    <Anchors>
                        <Anchor point="RIGHT">
                            <Offset>
                                <AbsDimension x="-8" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick>ItemBrowser_RowClick(self, button)</OnClick>
            <OnEnter>ItemBrowser_RowEnter(self)</OnEnter>
            <OnLeave>ItemBrowser_RowLeave()</OnLeave>
        </Scripts>
        <HighlightTexture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD"/>
    </Button>

    <!--
      One row of the category tree.

      Deliberately the stock auction house's filter button, down to the textures: the browse
      pane's class/subclass/slot list is built from AuctionClassButtonTemplate with
      UI-AuctionFrame-FilterBg behind it and UI-AuctionFrame-FilterLines drawing the little
      elbow on the deepest tier (Blizzard_AuctionUI.xml, FilterButton_SetType). Reusing it
      means the tree reads as part of the game rather than as an addon's idea of a tree.
    -->
    <Button name="ItemBrowserTreeNodeTemplate" virtual="true">
        <Size>
            <AbsDimension x="170" y="20"/>
        </Size>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentLines"
                         file="Interface\AuctionFrame\UI-AuctionFrame-FilterLines" hidden="true">
                    <Size>
                        <AbsDimension x="7" y="20"/>
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset>
                                <AbsDimension x="13" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                    <TexCoords left="0" right="0.4375" top="0" bottom="0.625"/>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick>ItemBrowserTree_NodeClick(self)</OnClick>
            <OnEnter>ItemBrowserTree_NodeEnter(self)</OnEnter>
            <OnLeave>GameTooltip:Hide()</OnLeave>
        </Scripts>
        <NormalTexture name="$parentNormalTexture"
                       file="Interface\AuctionFrame\UI-AuctionFrame-FilterBg">
            <TexCoords left="0" right="0.53125" top="0" bottom="0.625"/>
        </NormalTexture>
        <HighlightTexture file="Interface\PaperDollInfoFrame\UI-Character-Tab-Highlight"
                          alphaMode="ADD"/>
        <ButtonText name="$parentNormalText">
            <Anchors>
                <Anchor point="LEFT">
                    <Offset>
                        <AbsDimension x="4" y="0"/>
                    </Offset>
                </Anchor>
                <Anchor point="RIGHT">
                    <Offset>
                        <AbsDimension x="-4" y="0"/>
                    </Offset>
                </Anchor>
            </Anchors>
        </ButtonText>
        <NormalFont style="GameFontNormalSmallLeft"/>
        <HighlightFont style="GameFontHighlightSmallLeft"/>
    </Button>

    <!--
      A column heading that sorts the list.

      Clicking one is the fast path; the Sort menu is the discoverable one. Both write the
      same two saved fields, so the arrow here always agrees with the menu's tick.
    -->
    <Button name="ItemBrowserSortHeaderTemplate" virtual="true">
        <Size>
            <AbsDimension x="60" y="18"/>
        </Size>
        <Layers>
            <Layer level="ARTWORK">
                <Texture name="$parentArrow" file="Interface\Buttons\UI-SortArrow" hidden="true">
                    <Size>
                        <AbsDimension x="10" y="10"/>
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT" relativePoint="LEFT">
                            <Offset>
                                <AbsDimension x="-2" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick>ItemBrowser_SortHeaderClick(self)</OnClick>
            <OnEnter>ItemBrowser_SortHeaderEnter(self)</OnEnter>
            <OnLeave>GameTooltip:Hide()</OnLeave>
        </Scripts>
        <HighlightTexture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD"/>
        <ButtonText name="$parentText"/>
        <NormalFont style="GameFontHighlightSmall"/>
    </Button>

    <!--
      A labelled numeric box. Four of these hold the two ranges, and each one is tied to a
      slider that writes the same value. The caption is a child of the box it labels rather
      than of the window: a frame's Layers are built before its Frames, so a FontString
      declared up in the window's own Layers block cannot anchor to a widget that appears
      further down in Frames — at the moment the anchor is resolved that widget does not
      exist yet. Hanging the caption off the EditBox sidesteps the ordering.
    -->
    <EditBox name="ItemBrowserRangeBoxTemplate" inherits="InputBoxTemplate" virtual="true"
             numeric="true" autoFocus="false" letters="3">
        <Size>
            <AbsDimension x="34" y="20"/>
        </Size>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentLabel" inherits="GameFontNormalSmall" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="RIGHT" relativePoint="LEFT">
                            <Offset>
                                <AbsDimension x="-6" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnTextChanged>ItemBrowser_RangeBoxChanged(self)</OnTextChanged>
            <OnEscapePressed>self:ClearFocus()</OnEscapePressed>
            <OnEnterPressed>self:ClearFocus()</OnEnterPressed>
        </Scripts>
    </EditBox>

    <!--
      The slider half of a range bound.

      OptionsSliderTemplate ships three FontStrings (a caption above, low and high labels
      below). All three are blanked in Lua: the edit box next to the slider already shows the
      number, and the bounds live in the tooltip, so spending twenty vertical pixels on
      repeating them would push the results list down for nothing.

      3.3.5 has no SetObeyStepOnDrag — that is a Cataclysm addition — so dragging produces
      fractional values and the handler floors them. Mouse wheel is wired for one-step
      nudging, which is how you land on exactly 15 without hunting for the pixel.
    -->
    <Slider name="ItemBrowserRangeSliderTemplate" inherits="OptionsSliderTemplate"
            orientation="HORIZONTAL" virtual="true">
        <Size>
            <AbsDimension x="118" y="16"/>
        </Size>
        <Scripts>
            <OnLoad>ItemBrowser_RangeSliderLoad(self)</OnLoad>
            <OnValueChanged>ItemBrowser_RangeSliderChanged(self, value)</OnValueChanged>
            <OnMouseWheel>ItemBrowser_RangeSliderWheel(self, delta)</OnMouseWheel>
            <OnEnter>ItemBrowser_RangeSliderEnter(self)</OnEnter>
            <OnLeave>GameTooltip:Hide()</OnLeave>
        </Scripts>
    </Slider>

    <!-- A small square stepper, for quantity. -->
    <Button name="ItemBrowserStepperTemplate" virtual="true">
        <Size>
            <AbsDimension x="18" y="18"/>
        </Size>
        <Scripts>
            <OnClick>ItemBrowser_QuantityStep(self)</OnClick>
        </Scripts>
        <NormalTexture file="Interface\Buttons\UI-PlusButton-Up"/>
        <PushedTexture file="Interface\Buttons\UI-PlusButton-Down"/>
        <HighlightTexture file="Interface\Buttons\UI-PlusButton-Hilight" alphaMode="ADD"/>
    </Button>

    <Frame name="ItemBrowserFrame" parent="UIParent" toplevel="true" movable="true"
           resizable="true" enableMouse="true" clampedToScreen="true" hidden="true">
        <Size>
            <AbsDimension x="900" y="700"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets>
                <AbsInset left="11" right="12" top="12" bottom="11"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="32"/>
            </EdgeSize>
        </Backdrop>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormalLarge" text="Item Browser">
                    <Anchors>
                        <Anchor point="TOP">
                            <Offset>
                                <AbsDimension x="0" y="-14"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentTreeHeader" inherits="GameFontNormalSmall"
                            justifyH="LEFT" text="Categories">
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset>
                                <AbsDimension x="20" y="-222"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentStatus" inherits="GameFontHighlightSmall" justifyH="LEFT"
                            wordwrap="false" maxLines="1">
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset>
                                <AbsDimension x="212" y="-222"/>
                            </Offset>
                        </Anchor>
                        <Anchor point="TOPRIGHT">
                            <Offset>
                                <AbsDimension x="-16" y="-222"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentSelection" inherits="GameFontNormal" justifyH="LEFT"
                            wordwrap="false" maxLines="1">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT">
                            <Offset>
                                <AbsDimension x="22" y="62"/>
                            </Offset>
                        </Anchor>
                        <Anchor point="BOTTOMRIGHT">
                            <Offset>
                                <AbsDimension x="-22" y="62"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentRecipient" inherits="GameFontNormal" justifyH="LEFT"
                            wordwrap="false" maxLines="1">
                    <Size>
                        <AbsDimension x="330" y="14"/>
                    </Size>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT">
                            <Offset>
                                <AbsDimension x="22" y="42"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentFeedback" inherits="GameFontDisableSmall" justifyH="LEFT"
                            wordwrap="false" maxLines="1">
                    <Size>
                        <AbsDimension x="420" y="12"/>
                    </Size>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT">
                            <Offset>
                                <AbsDimension x="22" y="22"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentClose" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-5" y="-5"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>

            <!-- ============ line 1: name, quality, usable, reset ============ -->
            <EditBox name="$parentSearch" inherits="InputBoxTemplate" autoFocus="false"
                     historyLines="10">
                <Size>
                    <AbsDimension x="250" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="70" y="-42"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString name="$parentLabel" inherits="GameFontNormalSmall"
                                    justifyH="RIGHT" text="Name">
                            <Anchors>
                                <Anchor point="RIGHT" relativePoint="LEFT">
                                    <Offset>
                                        <AbsDimension x="-6" y="0"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                    <Layer level="OVERLAY">
                        <FontString name="$parentHint" inherits="GameFontDisableSmall"
                                    justifyH="LEFT" text="optional — name or item id">
                            <Anchors>
                                <Anchor point="LEFT">
                                    <Offset>
                                        <AbsDimension x="4" y="0"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnTextChanged>ItemBrowser_SearchChanged(self)</OnTextChanged>
                    <OnEscapePressed>self:ClearFocus()</OnEscapePressed>
                    <OnEnterPressed>self:ClearFocus()</OnEnterPressed>
                </Scripts>
            </EditBox>

            <Button name="$parentSearchClear" inherits="UIPanelCloseButton" hidden="true">
                <Size>
                    <AbsDimension x="22" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="$parentSearch" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="2" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>ItemBrowser_ClearSearch()</OnClick>
                </Scripts>
            </Button>

            <Frame name="$parentQuality" inherits="UIDropDownMenuTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentSearch" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="0" y="-2"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Frame>

            <CheckButton name="$parentUsable" inherits="UICheckButtonTemplate">
                <Size>
                    <AbsDimension x="24" y="24"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentQuality" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="-6" y="2"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>ItemBrowser_FilterChanged()</OnClick>
                    <OnEnter>ItemBrowser_UsableEnter(self)</OnEnter>
                    <OnLeave>GameTooltip:Hide()</OnLeave>
                </Scripts>
            </CheckButton>

            <Button name="$parentReset" inherits="UIPanelButtonTemplate">
                <Size>
                    <AbsDimension x="92" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-18" y="-41"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>ItemBrowser_ResetFilters()</OnClick>
                    <OnEnter>ItemBrowser_ResetEnter(self)</OnEnter>
                    <OnLeave>GameTooltip:Hide()</OnLeave>
                </Scripts>
            </Button>

            <!--
              ============ the two level ranges ============

              The box is decoration only and the controls are siblings of it, not children.
              $parent inside a nested frame resolves to THAT frame, so a LevelMin declared
              inside $parentLevels would be called ItemBrowserFrameLevelsLevelMin; keeping
              them at this level keeps every widget name a flat ItemBrowserFrame<Thing>,
              which is what the whole file (and the self-test) looks things up by.
            -->
            <Frame name="$parentLevels" inherits="OptionsBoxTemplate">
                <Size>
                    <AbsDimension x="100" y="132"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="18" y="-80"/>
                        </Offset>
                    </Anchor>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-204" y="-80"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Frame>

            <!-- required level: the level a character must BE to equip or use the item -->
            <EditBox name="$parentLevelMin" inherits="ItemBrowserRangeBoxTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentLevels" relativePoint="TOPLEFT">
                        <Offset>
                            <AbsDimension x="140" y="-10"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </EditBox>
            <Slider name="$parentReqMinSlider" inherits="ItemBrowserRangeSliderTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentLevelMin" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="8" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Slider>
            <EditBox name="$parentLevelMax" inherits="ItemBrowserRangeBoxTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentReqMinSlider" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="32" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </EditBox>
            <Slider name="$parentReqMaxSlider" inherits="ItemBrowserRangeSliderTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentLevelMax" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="8" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Slider>
            <Button name="$parentReqAny" inherits="UIPanelButtonTemplate" text="Any">
                <Size>
                    <AbsDimension x="46" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentReqMaxSlider" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="14" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>ItemBrowser_ClearRange("req")</OnClick>
                    <OnEnter>ItemBrowser_ClearRangeEnter(self, "req")</OnEnter>
                    <OnLeave>GameTooltip:Hide()</OnLeave>
                </Scripts>
            </Button>

            <!-- item level: the item's own power number, which is a different thing -->
            <EditBox name="$parentIlvlMin" inherits="ItemBrowserRangeBoxTemplate" letters="4">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentLevels" relativePoint="TOPLEFT">
                        <Offset>
                            <AbsDimension x="140" y="-76"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </EditBox>
            <Slider name="$parentIlvlMinSlider" inherits="ItemBrowserRangeSliderTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentIlvlMin" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="8" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Slider>
            <EditBox name="$parentIlvlMax" inherits="ItemBrowserRangeBoxTemplate" letters="4">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentIlvlMinSlider" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="32" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </EditBox>
            <Slider name="$parentIlvlMaxSlider" inherits="ItemBrowserRangeSliderTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentIlvlMax" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="8" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Slider>
            <Button name="$parentIlvlAny" inherits="UIPanelButtonTemplate" text="Any">
                <Size>
                    <AbsDimension x="46" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentIlvlMaxSlider" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="14" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>ItemBrowser_ClearRange("ilvl")</OnClick>
                    <OnEnter>ItemBrowser_ClearRangeEnter(self, "ilvl")</OnEnter>
                    <OnLeave>GameTooltip:Hide()</OnLeave>
                </Scripts>
            </Button>

            <!--
              Sort lives up here with the other controls rather than over the list, because a
              UIDropDownMenu's artwork is 64px tall and hangs well below its own frame: parked
              next to the column headings it would cover them and the first result row.
            -->
            <Frame name="$parentSort" inherits="UIDropDownMenuTemplate">
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-8" y="-84"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString name="$parentLabel" inherits="GameFontNormalSmall"
                                    justifyH="LEFT" text="Sort by">
                            <Anchors>
                                <Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT">
                                    <Offset>
                                        <AbsDimension x="22" y="-4"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
            </Frame>

            <!--
              The category tree. Same construction as the results list: a FauxScrollFrame that
              reports an offset, and a pool of buttons UI.lua re-fills from it.
            -->
            <Frame name="$parentTree" enableMouse="true">
                <Size>
                    <AbsDimension x="186" y="100"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="16" y="-258"/>
                        </Offset>
                    </Anchor>
                    <Anchor point="BOTTOMLEFT">
                        <Offset>
                            <AbsDimension x="16" y="84"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
                          edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <BackgroundInsets>
                        <AbsInset left="3" right="3" top="3" bottom="3"/>
                    </BackgroundInsets>
                    <TileSize>
                        <AbsValue val="16"/>
                    </TileSize>
                    <EdgeSize>
                        <AbsValue val="12"/>
                    </EdgeSize>
                </Backdrop>
                <Frames>
                    <ScrollFrame name="$parentScroll" inherits="FauxScrollFrameTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT">
                                <Offset>
                                    <AbsDimension x="4" y="-4"/>
                                </Offset>
                            </Anchor>
                            <Anchor point="BOTTOMRIGHT">
                                <Offset>
                                    <AbsDimension x="-26" y="4"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnVerticalScroll>
                                FauxScrollFrame_OnVerticalScroll(self, offset, 20, ItemBrowserTree_Update)
                            </OnVerticalScroll>
                        </Scripts>
                    </ScrollFrame>
                </Frames>
                <Scripts>
                    <OnLoad>ItemBrowserTree_OnLoad(self)</OnLoad>
                    <OnMouseWheel>ItemBrowserTree_OnMouseWheel(self, delta)</OnMouseWheel>
                </Scripts>
            </Frame>

            <!--
              List surface. Rows are CHILDREN of this frame, drawn on top of the
              FauxScrollFrame rather than inside it: a faux scroll frame never actually
              scrolls its content, it just reports an offset and the owner re-fills a fixed
              set of rows. However tall the window is, that is the entire widget budget — and
              with no filters at all, 46,098 items go through it. Mouse wheel is handled here
              because an unhandled wheel event walks up the parent chain from whichever row
              the cursor is over.
            -->
            <Frame name="$parentList" enableMouse="true">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentTree" relativePoint="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="10" y="0"/>
                        </Offset>
                    </Anchor>
                    <Anchor point="BOTTOMRIGHT">
                        <Offset>
                            <AbsDimension x="-16" y="84"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
                          edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <BackgroundInsets>
                        <AbsInset left="3" right="3" top="3" bottom="3"/>
                    </BackgroundInsets>
                    <TileSize>
                        <AbsValue val="16"/>
                    </TileSize>
                    <EdgeSize>
                        <AbsValue val="12"/>
                    </EdgeSize>
                </Backdrop>
                <Frames>
                    <ScrollFrame name="$parentScroll" inherits="FauxScrollFrameTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT">
                                <Offset>
                                    <AbsDimension x="4" y="-4"/>
                                </Offset>
                            </Anchor>
                            <Anchor point="BOTTOMRIGHT">
                                <Offset>
                                    <AbsDimension x="-26" y="4"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnVerticalScroll>
                                FauxScrollFrame_OnVerticalScroll(self, offset, 28, ItemBrowser_UpdateList)
                            </OnVerticalScroll>
                        </Scripts>
                    </ScrollFrame>
                </Frames>
                <Scripts>
                    <OnLoad>ItemBrowser_ListOnLoad(self)</OnLoad>
                    <OnMouseWheel>ItemBrowser_ListOnMouseWheel(self, delta)</OnMouseWheel>
                </Scripts>
            </Frame>

            <!--
              Column headings. Anchored to the list rather than to the window so they keep
              lining up with the row columns when the window is resized.
            -->
            <Frame name="$parentHeaders">
                <Size>
                    <AbsDimension x="100" y="18"/>
                </Size>
                <Anchors>
                    <Anchor point="BOTTOMLEFT" relativeTo="$parentList" relativePoint="TOPLEFT">
                        <Offset>
                            <AbsDimension x="6" y="2"/>
                        </Offset>
                    </Anchor>
                    <Anchor point="BOTTOMRIGHT" relativeTo="$parentList" relativePoint="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-26" y="2"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Frames>
                    <Button name="$parentName" inherits="ItemBrowserSortHeaderTemplate"
                            text="Item">
                        <Size>
                            <AbsDimension x="70" y="18"/>
                        </Size>
                        <Anchors>
                            <Anchor point="LEFT">
                                <Offset>
                                    <AbsDimension x="36" y="0"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                    </Button>
                    <Button name="$parentSlot" inherits="ItemBrowserSortHeaderTemplate"
                            text="Slot">
                        <Size>
                            <AbsDimension x="60" y="18"/>
                        </Size>
                        <Anchors>
                            <Anchor point="RIGHT">
                                <Offset>
                                    <AbsDimension x="-146" y="0"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                    </Button>
                    <Button name="$parentReq" inherits="ItemBrowserSortHeaderTemplate"
                            text="Req">
                        <Size>
                            <AbsDimension x="38" y="18"/>
                        </Size>
                        <Anchors>
                            <Anchor point="RIGHT">
                                <Offset>
                                    <AbsDimension x="-102" y="0"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                    </Button>
                    <Button name="$parentLevel" inherits="ItemBrowserSortHeaderTemplate"
                            text="ilvl">
                        <Size>
                            <AbsDimension x="38" y="18"/>
                        </Size>
                        <Anchors>
                            <Anchor point="RIGHT">
                                <Offset>
                                    <AbsDimension x="-58" y="0"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                    </Button>
                    <Button name="$parentId" inherits="ItemBrowserSortHeaderTemplate"
                            text="ID">
                        <Size>
                            <AbsDimension x="46" y="18"/>
                        </Size>
                        <Anchors>
                            <Anchor point="RIGHT">
                                <Offset>
                                    <AbsDimension x="-8" y="0"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                    </Button>
                </Frames>
            </Frame>

            <!-- ============ who gets what ============ -->
            <Button name="$parentGive" inherits="UIPanelButtonTemplate" text="Give">
                <Size>
                    <AbsDimension x="170" y="26"/>
                </Size>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT">
                        <Offset>
                            <AbsDimension x="-16" y="18"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>ItemBrowser_GiveClicked()</OnClick>
                    <OnEnter>ItemBrowser_GiveEnter(self)</OnEnter>
                    <OnLeave>GameTooltip:Hide()</OnLeave>
                </Scripts>
            </Button>

            <Button name="$parentQuantityUp" inherits="ItemBrowserStepperTemplate">
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="$parentGive" relativePoint="LEFT">
                        <Offset>
                            <AbsDimension x="-8" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>

            <EditBox name="$parentQuantity" inherits="InputBoxTemplate" numeric="true"
                     autoFocus="false" letters="4">
                <Size>
                    <AbsDimension x="42" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="$parentQuantityUp" relativePoint="LEFT">
                        <Offset>
                            <AbsDimension x="-4" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnTextChanged>ItemBrowser_QuantityChanged()</OnTextChanged>
                    <OnEscapePressed>self:ClearFocus()</OnEscapePressed>
                    <OnEnterPressed>self:ClearFocus()</OnEnterPressed>
                </Scripts>
            </EditBox>

            <Button name="$parentQuantityDown" inherits="ItemBrowserStepperTemplate">
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="$parentQuantity" relativePoint="LEFT">
                        <Offset>
                            <AbsDimension x="-8" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <NormalTexture file="Interface\Buttons\UI-MinusButton-Up"/>
                <PushedTexture file="Interface\Buttons\UI-MinusButton-Down"/>
            </Button>

            <!--
              The size grip. StartSizing("BOTTOMRIGHT") is the same call FloatingChatFrame.xml
              makes; SetMinResize/SetMaxResize are set in UI.lua because 3.3.5's XML schema has
              no element for them.
            -->
            <Button name="$parentResize">
                <Size>
                    <AbsDimension x="16" y="16"/>
                </Size>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT">
                        <Offset>
                            <AbsDimension x="-6" y="6"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnMouseDown>ItemBrowser_StartSizing()</OnMouseDown>
                    <OnMouseUp>ItemBrowser_StopSizing()</OnMouseUp>
                </Scripts>
                <NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
                <PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
                <HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight"
                                  alphaMode="ADD"/>
            </Button>
        </Frames>
        <Scripts>
            <OnLoad>ItemBrowser_OnLoad(self)</OnLoad>
            <OnEvent>ItemBrowser_OnEvent(self, event, ...)</OnEvent>
            <OnUpdate>ItemBrowser_OnUpdate(self, elapsed)</OnUpdate>
            <OnShow>ItemBrowser_OnShow(self)</OnShow>
            <OnHide>ItemBrowser_OnHide(self)</OnHide>
            <OnSizeChanged>ItemBrowser_OnSizeChanged(self)</OnSizeChanged>
            <OnDragStart>self:StartMoving()</OnDragStart>
            <OnDragStop>ItemBrowser_StopMoving(self)</OnDragStop>
        </Scripts>
    </Frame>
</Ui>
