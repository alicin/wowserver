<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">

    <!--
      ItemBrowser — frame layout.

      Widget tree in XML, behaviour in UI.lua, the 3.3.5 way. Everything here inherits from
      FrameXML templates that were confirmed present in THIS client's archives
      (UIPanelTemplates.xml / UIDropDownMenuTemplates.xml in patch-enUS-2/3.MPQ), so nothing
      depends on a library the pack does not ship.

      The filter bar is laid out the way the stock auction house lays its own out: name box
      first, then category / subcategory / quality as dropdowns, then the numeric ranges and
      the Usable checkbox on one line. Three rows of controls, then the list.
    -->

    <Script file="UI.lua"/>

    <!--
      One result row.

      The icon is TWO stacked textures on purpose. Five of the 4,851 distinct icon names in
      ItemDisplayInfo.dbc have no .blp anywhere in the client's archives (all of them on
      internal junk rows like "NPC Equip 6128"), and a texture with an unresolvable path
      simply draws nothing. Parking a question mark in the BACKGROUND layer means those rows
      show a question mark instead of a hole, with no per-item special-casing anywhere.

      26x26 in a 30px row, with the standard icon border around it. A bag slot is 37px and a
      character-pane slot 43px; 22px in a 26px row read as decoration rather than as the item.
    -->
    <Button name="ItemBrowserRowTemplate" virtual="true">
        <Size>
            <AbsDimension x="500" y="30"/>
        </Size>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentIconFallback" file="Interface\Icons\INV_Misc_QuestionMark">
                    <Size>
                        <AbsDimension x="26" y="26"/>
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset>
                                <AbsDimension x="5" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                    <TexCoords left="0.07" right="0.93" top="0.07" bottom="0.93"/>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture name="$parentSelected" file="Interface\QuestFrame\UI-QuestTitleHighlight"
                         alphaMode="ADD" hidden="true">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture name="$parentIcon">
                    <Size>
                        <AbsDimension x="26" y="26"/>
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset>
                                <AbsDimension x="5" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                    <!--
                      Crops the dark border baked into every Interface\Icons\ .blp. The whole
                      UI does this (see any action button); without it a 26px icon spends
                      three of those pixels on a smudge.
                    -->
                    <TexCoords left="0.07" right="0.93" top="0.07" bottom="0.93"/>
                </Texture>
                <!--
                  wordwrap="false" maxLines="1" on both text columns: a FontString with a
                  fixed <Size> and no cap WRAPS, and "Sanctified Ymirjar Lord's Breastplate"
                  wrapping to a second line inside a 30px row would push the layout apart.
                -->
                <FontString name="$parentName" inherits="GameFontNormal" justifyH="LEFT"
                            wordwrap="false" maxLines="1">
                    <Size>
                        <AbsDimension x="228" y="14"/>
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentIcon" relativePoint="RIGHT">
                            <Offset>
                                <AbsDimension x="8" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentCategory" inherits="GameFontDisableSmall"
                            justifyH="RIGHT" wordwrap="false" maxLines="1">
                    <Size>
                        <AbsDimension x="106" y="12"/>
                    </Size>
                    <Anchors>
                        <Anchor point="RIGHT">
                            <Offset>
                                <AbsDimension x="-120" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentLevel" inherits="GameFontHighlightSmall"
                            justifyH="RIGHT">
                    <Size>
                        <AbsDimension x="58" y="12"/>
                    </Size>
                    <Anchors>
                        <Anchor point="RIGHT">
                            <Offset>
                                <AbsDimension x="-58" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentId" inherits="GameFontDisableSmall" justifyH="RIGHT">
                    <Size>
                        <AbsDimension x="50" y="12"/>
                    </Size>
                    <Anchors>
                        <Anchor point="RIGHT">
                            <Offset>
                                <AbsDimension x="-6" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick>ItemBrowser_RowClick(self)</OnClick>
            <OnEnter>ItemBrowser_RowEnter(self)</OnEnter>
            <OnLeave>ItemBrowser_RowLeave(self)</OnLeave>
        </Scripts>
        <HighlightTexture file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD"/>
    </Button>

    <!--
      A labelled numeric box. Four of these make the two ranges. The caption is a child of
      the box it labels rather than of the window: a frame's Layers are built before its
      Frames, so a FontString declared up in the window's own Layers block cannot anchor to a
      widget that appears further down in Frames — at the moment the anchor is resolved that
      widget does not exist yet. Hanging the caption off the EditBox sidesteps the ordering.
    -->
    <EditBox name="ItemBrowserRangeBoxTemplate" inherits="InputBoxTemplate" virtual="true"
             numeric="true" autoFocus="false" letters="3">
        <Size>
            <AbsDimension x="36" y="20"/>
        </Size>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentLabel" inherits="GameFontNormalSmall" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="RIGHT" relativePoint="LEFT">
                            <Offset>
                                <AbsDimension x="-6" y="0"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnTextChanged>ItemBrowser_FilterChanged()</OnTextChanged>
            <OnEscapePressed>self:ClearFocus()</OnEscapePressed>
            <OnEnterPressed>self:ClearFocus()</OnEnterPressed>
        </Scripts>
    </EditBox>

    <Frame name="ItemBrowserFrame" parent="UIParent" toplevel="true" movable="true"
           enableMouse="true" clampedToScreen="true" hidden="true">
        <Size>
            <AbsDimension x="558" y="640"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <BackgroundInsets>
                <AbsInset left="11" right="12" top="12" bottom="11"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="32"/>
            </EdgeSize>
        </Backdrop>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormalLarge" text="Item Browser">
                    <Anchors>
                        <Anchor point="TOP">
                            <Offset>
                                <AbsDimension x="0" y="-14"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentStatus" inherits="GameFontHighlightSmall" justifyH="LEFT">
                    <Size>
                        <AbsDimension x="516" y="12"/>
                    </Size>
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset>
                                <AbsDimension x="22" y="-136"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentSelection" inherits="GameFontNormal" justifyH="LEFT"
                            wordwrap="false" maxLines="1">
                    <Size>
                        <AbsDimension x="516" y="14"/>
                    </Size>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT">
                            <Offset>
                                <AbsDimension x="22" y="62"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentRecipient" inherits="GameFontNormal" justifyH="LEFT"
                            wordwrap="false" maxLines="1">
                    <Size>
                        <AbsDimension x="272" y="14"/>
                    </Size>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT">
                            <Offset>
                                <AbsDimension x="22" y="42"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentFeedback" inherits="GameFontDisableSmall" justifyH="LEFT"
                            wordwrap="false" maxLines="1">
                    <Size>
                        <AbsDimension x="272" y="12"/>
                    </Size>
                    <Anchors>
                        <Anchor point="BOTTOMLEFT">
                            <Offset>
                                <AbsDimension x="22" y="22"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentClose" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-5" y="-5"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>

            <!-- ============ filter row 1: the name box ============ -->
            <EditBox name="$parentSearch" inherits="InputBoxTemplate" autoFocus="false"
                     historyLines="10">
                <Size>
                    <AbsDimension x="330" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="70" y="-40"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString name="$parentLabel" inherits="GameFontNormalSmall"
                                    justifyH="RIGHT" text="Name">
                            <Anchors>
                                <Anchor point="RIGHT" relativePoint="LEFT">
                                    <Offset>
                                        <AbsDimension x="-6" y="0"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                    <Layer level="OVERLAY">
                        <FontString name="$parentHint" inherits="GameFontDisableSmall"
                                    justifyH="LEFT" text="name or item id...">
                            <Anchors>
                                <Anchor point="LEFT">
                                    <Offset>
                                        <AbsDimension x="4" y="0"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnTextChanged>ItemBrowser_SearchChanged(self)</OnTextChanged>
                    <OnEscapePressed>self:ClearFocus()</OnEscapePressed>
                    <OnEnterPressed>self:ClearFocus()</OnEnterPressed>
                </Scripts>
            </EditBox>

            <Button name="$parentReset" inherits="UIPanelButtonTemplate">
                <Size>
                    <AbsDimension x="76" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-18" y="-39"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>ItemBrowser_ResetFilters()</OnClick>
                </Scripts>
            </Button>

            <!-- ============ filter row 2: category / subcategory / quality ============ -->
            <Frame name="$parentCategory" inherits="UIDropDownMenuTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="8" y="-62"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Frame>

            <Frame name="$parentSubCategory" inherits="UIDropDownMenuTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentCategory" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="-12" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Frame>

            <Frame name="$parentQuality" inherits="UIDropDownMenuTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentSubCategory" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="-12" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Frame>

            <!-- ============ filter row 3: the two ranges and Usable ============ -->
            <EditBox name="$parentLevelMin" inherits="ItemBrowserRangeBoxTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="94" y="-102"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </EditBox>
            <EditBox name="$parentLevelMax" inherits="ItemBrowserRangeBoxTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentLevelMin" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="22" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </EditBox>

            <EditBox name="$parentIlvlMin" inherits="ItemBrowserRangeBoxTemplate" letters="4">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentLevelMax" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="72" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </EditBox>
            <EditBox name="$parentIlvlMax" inherits="ItemBrowserRangeBoxTemplate" letters="4">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="$parentIlvlMin" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="22" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </EditBox>

            <CheckButton name="$parentUsable" inherits="UICheckButtonTemplate">
                <Size>
                    <AbsDimension x="24" y="24"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-108" y="-98"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>ItemBrowser_FilterChanged()</OnClick>
                    <OnEnter>ItemBrowser_UsableEnter(self)</OnEnter>
                    <OnLeave>GameTooltip:Hide()</OnLeave>
                </Scripts>
            </CheckButton>

            <!--
              List surface. Rows are CHILDREN of this frame, drawn on top of the
              FauxScrollFrame rather than inside it: a faux scroll frame never actually
              scrolls its content, it just reports an offset and the owner re-fills a fixed
              set of rows. Thirteen rows is the whole widget budget no matter how many items
              match — and with no filters at all, 46,098 of them do. Mouse wheel is handled
              here because an unhandled wheel event walks up the parent chain from whichever
              row the cursor is over.
            -->
            <Frame name="$parentList" enableMouse="true">
                <Size>
                    <AbsDimension x="530" y="398"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="14" y="-152"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Backdrop bgFile="Interface\Tooltips\UI-Tooltip-Background"
                          edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
                    <BackgroundInsets>
                        <AbsInset left="3" right="3" top="3" bottom="3"/>
                    </BackgroundInsets>
                    <TileSize>
                        <AbsValue val="16"/>
                    </TileSize>
                    <EdgeSize>
                        <AbsValue val="12"/>
                    </EdgeSize>
                </Backdrop>
                <Frames>
                    <ScrollFrame name="$parentScroll" inherits="FauxScrollFrameTemplate">
                        <Size>
                            <AbsDimension x="500" y="390"/>
                        </Size>
                        <Anchors>
                            <Anchor point="TOPLEFT">
                                <Offset>
                                    <AbsDimension x="4" y="-4"/>
                                </Offset>
                            </Anchor>
                        </Anchors>
                        <Scripts>
                            <OnVerticalScroll>
                                FauxScrollFrame_OnVerticalScroll(self, offset, 30, ItemBrowser_UpdateList)
                            </OnVerticalScroll>
                        </Scripts>
                    </ScrollFrame>
                </Frames>
                <Scripts>
                    <OnLoad>ItemBrowser_ListOnLoad(self)</OnLoad>
                    <OnMouseWheel>ItemBrowser_ListOnMouseWheel(self, delta)</OnMouseWheel>
                </Scripts>
            </Frame>

            <Button name="$parentGive" inherits="UIPanelButtonTemplate" text="Give">
                <Size>
                    <AbsDimension x="150" y="24"/>
                </Size>
                <Anchors>
                    <Anchor point="BOTTOMRIGHT">
                        <Offset>
                            <AbsDimension x="-16" y="18"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>ItemBrowser_GiveClicked()</OnClick>
                    <OnEnter>ItemBrowser_GiveEnter(self)</OnEnter>
                    <OnLeave>GameTooltip:Hide()</OnLeave>
                </Scripts>
            </Button>

            <EditBox name="$parentQuantity" inherits="InputBoxTemplate" numeric="true"
                     autoFocus="false" letters="4">
                <Size>
                    <AbsDimension x="42" y="20"/>
                </Size>
                <Anchors>
                    <Anchor point="RIGHT" relativeTo="$parentGive" relativePoint="LEFT">
                        <Offset>
                            <AbsDimension x="-14" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <FontString name="$parentLabel" inherits="GameFontNormalSmall" text="Qty">
                            <Anchors>
                                <Anchor point="RIGHT" relativePoint="LEFT">
                                    <Offset>
                                        <AbsDimension x="-4" y="0"/>
                                    </Offset>
                                </Anchor>
                            </Anchors>
                        </FontString>
                    </Layer>
                </Layers>
                <Scripts>
                    <OnTextChanged>ItemBrowser_QuantityChanged()</OnTextChanged>
                    <OnEscapePressed>self:ClearFocus()</OnEscapePressed>
                    <OnEnterPressed>self:ClearFocus()</OnEnterPressed>
                </Scripts>
            </EditBox>
        </Frames>
        <Scripts>
            <OnLoad>ItemBrowser_OnLoad(self)</OnLoad>
            <OnEvent>ItemBrowser_OnEvent(self, event, ...)</OnEvent>
            <OnUpdate>ItemBrowser_OnUpdate(self, elapsed)</OnUpdate>
            <OnShow>ItemBrowser_OnShow(self)</OnShow>
            <OnHide>ItemBrowser_OnHide(self)</OnHide>
            <OnDragStart>self:StartMoving()</OnDragStart>
            <OnDragStop>ItemBrowser_StopMoving(self)</OnDragStop>
        </Scripts>
    </Frame>
</Ui>
